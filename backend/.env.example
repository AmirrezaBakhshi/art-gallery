# Local development defaults. Replace the secret and all host/origin values for deployment.
DJANGO_SECRET_KEY=local-development-only-change-this-secret-before-deploying-1234567890
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_COOKIE_SAMESITE=Lax
GALLERY_LOGIN_RATE=5/minute
GALLERY_SIGNUP_RATE=3/hour
GALLERY_SESSION_TTL_DAYS=14

# Production example (configure these for your actual domains):
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# Enable only when a trusted reverse proxy overwrites X-Forwarded-Proto:
# DJANGO_TRUST_PROXY_SSL_HEADER=true
# DJANGO_COOKIE_SAMESITE=Lax
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_HSTS_PRELOAD=false
# For frontend/API on different sites, use SameSite=None with HTTPS.
# Optional PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/artgallery
